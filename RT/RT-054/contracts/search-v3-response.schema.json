{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwk.local/schemas/cwk.kb.search.v3.response.json",
  "title": "CWK KB Search v3 success response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "request_id", "effective_kb_ids", "epochs", "retrieval", "no_evidence", "total", "hits", "timings_ms"],
  "properties": {
    "schema": {"const": "cwk.kb.search.v3"},
    "ok": {"const": true},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "effective_kb_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "epochs": {"type": "object", "minProperties": 1, "maxProperties": 20, "additionalProperties": {"type": "integer", "minimum": 1}},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "mapping_version", "chunker_version", "analyzer_version"],
      "properties": {
        "mode": {"const": "bm25"},
        "mapping_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "chunker_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "analyzer_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "no_evidence": {"type": "boolean"},
    "total": {"type": "integer", "minimum": 0},
    "hits": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kb_id", "doc_id", "source_version", "title", "section_path", "locator", "excerpt", "rank", "score_kind"],
        "properties": {
          "kb_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "doc_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_version": {"type": "integer", "minimum": 1},
          "title": {"type": ["string", "null"], "maxLength": 1024},
          "section_path": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_start": {"type": ["integer", "null"], "minimum": 1},
              "page_end": {"type": ["integer", "null"], "minimum": 1},
              "sheet_name": {"type": ["string", "null"], "maxLength": 256},
              "row_start": {"type": ["integer", "null"], "minimum": 1},
              "row_end": {"type": ["integer", "null"], "minimum": 1},
              "paragraph_start": {"type": ["integer", "null"], "minimum": 1},
              "paragraph_end": {"type": ["integer", "null"], "minimum": 1}
            }
          },
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 12000},
          "rank": {"type": "integer", "minimum": 1, "maximum": 50},
          "score_kind": {"const": "bm25_rank_v1"}
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "control", "search", "objects"],
      "properties": {
        "total": {"type": "number", "minimum": 0},
        "control": {"type": "number", "minimum": 0},
        "search": {"type": "number", "minimum": 0},
        "objects": {"type": "number", "minimum": 0}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"no_evidence": {"const": true}}}, "then": {"properties": {"total": {"const": 0}, "hits": {"maxItems": 0}}}},
    {"if": {"properties": {"no_evidence": {"const": false}}}, "then": {"properties": {"total": {"minimum": 1}, "hits": {"minItems": 1}}}}
  ]
}
