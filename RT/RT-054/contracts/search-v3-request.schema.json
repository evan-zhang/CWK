{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwk.local/schemas/cwk.kb.search.v3.request.json",
  "title": "CWK KB Search v3 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["kb_ids", "query", "request_id"],
  "properties": {
    "kb_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
    },
    "query": {"type": "string", "minLength": 1, "maxLength": 512},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
