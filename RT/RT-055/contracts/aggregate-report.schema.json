    "freezeB": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "candidate_id",
        "code_digest",
        "image_digest",
        "config_digest",
        "mapping_digest",
        "query_plan_digest",
        "dependency_digest",
