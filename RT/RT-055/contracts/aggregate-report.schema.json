        },
        "frozen_before_run": {
          "const": true
        },
        "ops_artifacts_verified": {
          "const": true
        },
        "head_matches_commit": {
          "const": true
        },
        "tree_clean": {
          "const": true
        },
        "native_config": {
          "const": true
