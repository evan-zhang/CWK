    "candidateA": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "freeze_receipt",
        "libraries",
        "operations",
        "gateway_readiness"
      ],
      "properties": {
        "identity": {
          "const": {
            "kind": "opensearch_dual_channel",
            "exact_resolver": "deterministic_v1",
            "lexical_analyzer": "analysis_icu",
            "doc_collapse": true,
            "parent_expand": true,
            "rerank_in_primary": false
          }
        },
        "freeze_receipt": {
          "$ref": "#/$defs/freezeA"
        },
        "libraries": {
          "$ref": "#/$defs/libraries"
        },
        "operations": {
          "$ref": "#/$defs/operations"
        },
        "gateway_readiness": {
          "$ref": "#/$defs/gateway"
        }
      }
    },
    "candidateB": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "freeze_receipt",
        "libraries",
        "operations",
        "gateway_readiness"
      ],
      "properties": {
        "identity": {
          "const": {
            "kind": "weknora",
            "commit": "8d7298fb5d759973cb1e481cadc5ecdf16dca599",
            "native_pipeline": true,
            "core_modified": false
          }
        },
        "freeze_receipt": {
