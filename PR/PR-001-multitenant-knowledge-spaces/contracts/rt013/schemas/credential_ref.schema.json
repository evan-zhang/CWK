{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt013.credential_ref.v1",
  "title": "Credential Reference Record v1 (RT-013)",
  "description": "Per-tenant opaque credential reference.  Material NEVER lives here; only a URI that points to a secret backend adapter.  During rotation both current and secondary references live on the same record; the pointer swap is atomic.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "reference_uri",
    "backend",
    "status",
    "credential_epoch",
    "created_at",
    "updated_at",
    "rotation",
    "provisioning",
    "history"
  ],
  "properties": {
    "schema": {"const": "cwk.rt013.credential_ref.v1"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "reference_uri": {"type": "string", "pattern": "^secret://[a-z0-9._-]{1,128}$"},
    "backend": {"type": "string", "enum": ["env_ref", "file_ref"]},
    "status": {"type": "string", "enum": ["active", "disabled", "revoked", "rotating"]},
    "credential_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "secondary_reference_uri", "secondary_backend", "secondary_credential_epoch", "previous_credential_epoch"],
      "properties": {
        "state": {"type": "string", "enum": ["stable", "dual_write", "finalizing"]},
        "secondary_reference_uri": {"type": ["string", "null"], "pattern": "^secret://[a-z0-9._-]{1,128}$"},
        "secondary_backend": {"type": ["string", "null"], "enum": [null, "env_ref", "file_ref"]},
        "secondary_credential_epoch": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
        "previous_credential_epoch": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_receipt_id", "last_receipt_sha256"],
      "properties": {
        "last_receipt_id": {"type": "string", "pattern": "^rcrd_[a-z0-9]{26}$"},
        "last_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "at", "actor", "reason", "credential_epoch_after", "receipt_id"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["set", "disable", "revoke", "rotation_begin", "rotation_finalize"]
          },
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {"type": "string", "minLength": 1, "maxLength": 256},
          "credential_epoch_after": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "receipt_id": {"type": "string", "pattern": "^rcrd_[a-z0-9]{26}$"}
        }
      }
    }
  }
}
