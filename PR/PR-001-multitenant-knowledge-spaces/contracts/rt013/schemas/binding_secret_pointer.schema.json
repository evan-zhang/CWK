{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt013.binding_secret_pointer.v1",
  "title": "Binding Secret Pointer v1 (RT-013)",
  "description": "Names the current (and, during rotation, secondary and previous) HMAC secret epoch used to derive agent_id_hash from raw agent_id.  The material itself lives in registry/binding-secrets/material/<epoch>.material and is NEVER present in this record.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "rotation_state",
    "current_epoch",
    "secondary_epoch",
    "previous_epoch",
    "updated_at",
    "provisioning"
  ],
  "properties": {
    "schema": {"const": "cwk.rt013.binding_secret_pointer.v1"},
    "rotation_state": {"type": "string", "enum": ["stable", "dual_write", "finalizing"]},
    "current_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "secondary_epoch": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "previous_epoch": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "updated_at": {"type": "string", "format": "date-time"},
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_receipt_id", "last_receipt_sha256"],
      "properties": {
        "last_receipt_id": {"type": "string", "pattern": "^rsec_[a-z0-9]{26}$"},
        "last_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
