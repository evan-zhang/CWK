{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt013.credential_broker_lease.v1",
  "title": "Credential Broker Lease Receipt v1 (RT-013)",
  "description": "Audit receipt emitted for every material acquisition through the Credential Broker.  Contains only opaque identifiers; NEVER the material, the raw agent_id, backend material paths, or absolute host paths.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "lease_id",
    "tenant_id",
    "agent_id_hash",
    "reference_uri",
    "backend",
    "credential_epoch",
    "purpose",
    "issued_at",
    "released_at",
    "tenant_status",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "cwk.rt013.credential_broker_lease.v1"},
    "lease_id": {"type": "string", "pattern": "^lease_[a-z0-9]{26}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "agent_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_uri": {"type": "string", "pattern": "^secret://[a-z0-9._-]{1,128}$"},
    "backend": {"type": "string", "enum": ["env_ref", "file_ref"]},
    "credential_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "purpose": {
      "type": "string",
      "enum": [
        "sampling_collect_bounded",
        "collector_run",
        "scheduler_run",
        "profile_ai",
        "profile_confirm",
        "query_broker"
      ]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": "string", "format": "date-time"},
    "tenant_status": {
      "type": "string",
      "enum": ["profile_pending", "pilot", "active"]
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
