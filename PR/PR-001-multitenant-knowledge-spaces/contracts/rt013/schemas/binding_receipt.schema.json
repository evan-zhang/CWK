{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt013.binding_receipt.v1",
  "title": "Binding Audit Receipt v1 (RT-013)",
  "description": "Append-only audit trail for every binding mutate.  Contains no raw agent_id, no credential material and no absolute host paths.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "tenant_id",
    "agent_id_hash",
    "action",
    "binding_epoch_before",
    "binding_epoch_after",
    "binding_secret_epoch",
    "committed_at",
    "actor",
    "reason",
    "tenant_auth_epoch_before",
    "tenant_auth_epoch_after",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "cwk.rt013.binding_receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^rbnd_[a-z0-9]{26}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "agent_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "type": "string",
      "enum": [
        "bind",
        "rebind_out",
        "rebind_in",
        "revoke",
        "suspend",
        "reactivate",
        "secret_rotation_begin",
        "secret_rotation_finalize"
      ]
    },
    "binding_epoch_before": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "binding_epoch_after": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "binding_secret_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "committed_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_auth_epoch_before": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "tenant_auth_epoch_after": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
