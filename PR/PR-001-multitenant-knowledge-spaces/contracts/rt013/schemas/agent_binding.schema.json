{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt013.agent_binding.v1",
  "title": "Agent Binding Record v1 (RT-013)",
  "description": "Persistent binding of an opaque agent_id_hash to a tenant_id.  The raw agent_id is NEVER stored; only the HMAC-SHA256 hash.  Binding epoch increases monotonically on every mutate (bind/rebind/revoke/suspend/reactivate/secret_rotation).",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "agent_id_hash",
    "tenant_id",
    "binding_epoch",
    "binding_secret_epoch",
    "status",
    "bound_at",
    "updated_at",
    "revoked_at",
    "provisioning",
    "history"
  ],
  "properties": {
    "schema": {"const": "cwk.rt013.agent_binding.v1"},
    "agent_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "binding_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "binding_secret_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "status": {"type": "string", "enum": ["active", "suspended", "revoked"]},
    "bound_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_receipt_id", "last_receipt_sha256"],
      "properties": {
        "last_receipt_id": {"type": "string", "pattern": "^rbnd_[a-z0-9]{26}$"},
        "last_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "at",
          "actor",
          "reason",
          "binding_epoch_after",
          "binding_secret_epoch",
          "tenant_id",
          "receipt_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "bind",
              "rebind_out",
              "rebind_in",
              "revoke",
              "suspend",
              "reactivate",
              "secret_rotation_begin",
              "secret_rotation_finalize"
            ]
          },
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {"type": "string", "minLength": 1, "maxLength": 256},
          "binding_epoch_after": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "binding_secret_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
          "receipt_id": {"type": "string", "pattern": "^rbnd_[a-z0-9]{26}$"}
        }
      }
    }
  }
}
