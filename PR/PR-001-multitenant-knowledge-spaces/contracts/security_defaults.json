{
  "schema": "cwk.security_defaults.v1",
  "version": "v1",
  "frozen_by": "RT-011",
  "frozen_at": "2026-08-19",
  "note": "This document freezes policy defaults for PR-001. Runtime SLA numbers (P50/P95, RTO/RPO, per-tenant quotas) are intentionally absent; they are measured by RT-024/RT-025.",

  "report_key_composition": {
    "form": "source_namespace + ':' + report_id",
    "encoding": "utf-8",
    "reason": "PRD FR-06/§10 and DESIGN §17 T-12 require namespace-prefixed keys until global uniqueness is verified.",
    "downgrade_forbidden": true
  },

  "canonical_json": {
    "unicode_normalization": "NFC",
    "canonicalization": "RFC 8785 JCS",
    "encoding": "utf-8",
    "note": "Strings are NFC-normalized BEFORE JCS. JCS does not perform Unicode normalization; skipping NFC is not permitted."
  },

  "object_id": {
    "form": "'o_' + base32(random 128 bit).lower().rstrip('=')",
    "entropy_bits": 128,
    "alphabet": "RFC 4648 base32 (a-z2-7), lowercase",
    "regex": "^o_[a-z2-7]{26}$",
    "note": "Object IDs are opaque; SHA-256 MUST NOT be exposed as an object ID or via any hash-existence API."
  },

  "profile_sha256_recipe": {
    "domain_separator_ascii": "cwk-profile-v1",
    "byte_formula": "sha256(b'cwk-profile-v1' + b'\\x00' + jcs_utf8(nfc_normalized_proposal) + b'\\x00' + sample_manifest_sha256_ascii + b'\\x00' + prompt_template_sha256_ascii + b'\\x00' + model_id_utf8)",
    "required_inputs": [
      "nfc_normalized_proposal",
      "sample_manifest_sha256",
      "prompt_template_sha256",
      "model_id"
    ],
    "component_separator": "0x00",
    "no_concatenation_without_separator": true,
    "reject_missing_inputs": true
  },

  "transport_and_identity": {
    "preferred_transport": "openclaw_controlled_tool",
    "fallback_transport": "unix_domain_socket_peercred",
    "forbidden_transport": "loopback_http_self_reported_agent_id",
    "identity_source": "gateway_authenticated_context",
    "request_body_identity_fields_permitted": false,
    "note": "Runtime compliance is enforced by RT-023 + VG-D + G5; RT-011 only freezes policy defaults and machine-readable capability probe outputs."
  },

  "access_grant": {
    "states": [
      "discovered",
      "granted",
      "active",
      "revalidation_due",
      "revoked",
      "purge_pending",
      "purged"
    ],
    "query_eligible_states": ["active"],
    "fail_closed_states": [
      "discovered",
      "granted",
      "revalidation_due",
      "revoked",
      "purge_pending",
      "purged"
    ],
    "grace_read_forbidden": true,
    "revalidation_due_interval_max_seconds": 900,
    "revocation_ack_target_seconds": null,
    "derived_cleanup_target_seconds": null,
    "sla_measurement_owner": "RT-024",
    "sla_confirmation_owner": "RT-026"
  },

  "profile_lifecycle": {
    "version_states": [
      "draft",
      "proposed",
      "preview",
      "confirmed",
      "active",
      "superseded"
    ],
    "rolled_back_state_forbidden": true,
    "rollback_mechanism": "profile_pointer_rollback event",
    "rollback_target": "most_recent_superseded_only"
  },

  "cold_archive": {
    "physical_delete_default": false,
    "included_dispositions_default": ["index"],
    "opt_in_dispositions": ["archive_no_index", "review"],
    "archive_no_index_limit_ratio_max": 0.5,
    "archive_no_index_scan_raw_forbidden": true
  },

  "cache_key": {
    "required_components": [
      "tenant_id",
      "auth_epoch",
      "profile_sha256",
      "space_ids",
      "query_hash",
      "filter_hash",
      "index_version"
    ],
    "cross_tenant_share_forbidden": true
  },

  "logging": {
    "forbidden_content": [
      "app_key",
      "raw_full_body",
      "full_query_text",
      "attachment_temporary_url",
      "host_absolute_path"
    ],
    "audit_append_only": true
  },

  "break_glass": {
    "enabled": false,
    "note": "First-stage has no break-glass. Any future break-glass must be time-bound, two-person approved, fully audited, and shipped by a separate PR."
  }
}
