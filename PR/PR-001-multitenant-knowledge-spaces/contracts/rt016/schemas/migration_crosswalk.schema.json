{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt016.migration_crosswalk.v1",
  "title": "RT-016 legacy-to-canonical migration crosswalk v1",
  "description": "One durable per-report crosswalk written by ShadowImporter to prove: (1) the legacy raw bytes have been decomposed and the resulting canonical envelope was published to the RT-014 Shared Evidence Store; (2) an RT-015 access observation was recorded (initial_status='granted' only — never active); (3) the tenant view envelope is preserved (either upserted via RT-015 with a valid authority receipt, or deferred with a clear fail-closed reason). Each crosswalk lives in RT-016's own tenant-scoped namespace under registry/rt016-crosswalk/<tenant_id>/crosswalks/. The three distinct SHA-256 fields are never asserted equal: legacy_source_sha256 (exact raw bytes), canonical_sha256 (NFC+JCS of the canonical envelope) and object_bytes_sha256 (RT-014 catalog storage bytes). Multiple crosswalks may share the same canonical_sha256 (e.g. overlay-only legacy diff). Python callers re-validate the nested tenant_view_envelope, publish_receipt and decompose_report against their frozen schemas.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "crosswalk_key",
    "tenant_id",
    "view_key",
    "report_key",
    "source_namespace",
    "report_id",
    "source_kind",
    "legacy_source_sha256",
    "canonical_sha256",
    "object_bytes_sha256",
    "object_id",
    "catalog_key",
    "catalog_revision",
    "publish_receipt",
    "observe_grant_key",
    "observation_source",
    "initial_status",
    "tenant_view_envelope",
    "tenant_view_written",
    "tenant_view_deferred_reason",
    "tenant_view_record_revision",
    "timeline_snapshot_hashes",
    "timeline_event_hashes",
    "decomposer_version",
    "normalizer_version",
    "decompose_report",
    "migration_status",
    "run_id",
    "run_started_at",
    "created_at",
    "record_revision"
  ],
  "properties": {
    "schema": {"const": "cwk.rt016.migration_crosswalk.v1"},
    "crosswalk_key": {"type": "string", "pattern": "^cw_[a-z2-7]{26}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "view_key": {"type": "string", "pattern": "^g_[a-z2-7]{26}$"},
    "report_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}:[A-Za-z0-9][A-Za-z0-9_\\-.]{0,127}$"
    },
    "source_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-.]{0,127}$"},
    "source_kind": {"type": "string", "enum": ["current_raw", "timeline_snapshot"]},
    "legacy_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^o_[a-z2-7]{26}$"},
    "catalog_key": {"type": "string", "pattern": "^r_[a-z2-7]{26}$"},
    "catalog_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "publish_receipt": {"type": "object"},
    "observe_grant_key": {"type": "string", "pattern": "^g_[a-z2-7]{26}$"},
    "observation_source": {"type": "string", "const": "legacy_raw_decomposition"},
    "initial_status": {"type": "string", "const": "granted"},
    "tenant_view_envelope": {"type": "object"},
    "tenant_view_written": {"type": "boolean"},
    "tenant_view_deferred_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "no_authority_receipt_available",
        "authority_receipt_rejected",
        "access_ledger_denied",
        "canonical_missing",
        "in_flight_revocation",
        "not_attempted"
      ]
    },
    "tenant_view_record_revision": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "timeline_snapshot_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true,
      "maxItems": 4096
    },
    "timeline_event_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true,
      "maxItems": 4096
    },
    "decomposer_version": {"type": "string", "pattern": "^v[0-9]{1,4}$"},
    "normalizer_version": {"type": "string", "pattern": "^v[0-9]{1,4}$"},
    "decompose_report": {"type": "object"},
    "migration_status": {"type": "string", "enum": ["complete"]},
    "run_id": {"type": "string", "pattern": "^run_[a-z2-7]{26}$"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "customKeywords": {
    "deepForbiddenProperties": [
      "agent_id", "agent_id_hash", "credential_ref", "credentials", "app_key", "app_secret",
      "canonical_body", "body_text", "reply_body", "node_body", "raw_body", "full_content",
      "html", "message", "opinion",
      "absolute_path", "mirror_root", "cwork_root", "instance_root",
      "attachment_url", "preview_url", "short_url", "presign_url", "download_url",
      "cookie", "session_token", "authorization", "prompt_template",
      "auth_epoch", "binding_epoch"
    ]
  }
}
