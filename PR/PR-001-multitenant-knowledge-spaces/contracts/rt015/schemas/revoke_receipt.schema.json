{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt015.revoke_receipt.v1",
  "title": "AccessLedger revocation receipt v1 (RT-015)",
  "description": "Immutable audit record produced only after every crash-safe revocation step (mark revoked, bump tenant auth_epoch, write tombstone, write cleanup outbox) has succeeded. Presence of a matching receipt file allows recovery to consider the intent complete.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "txn_id",
    "grant_key",
    "tenant_id",
    "source_namespace",
    "report_id",
    "tenant_auth_epoch_before",
    "tenant_auth_epoch_after",
    "record_revision_after",
    "tombstone_sha256",
    "cleanup_outbox_sha256",
    "revoked_at",
    "actor",
    "reason"
  ],
  "properties": {
    "schema": {"const": "cwk.rt015.revoke_receipt.v1"},
    "txn_id": {"type": "string", "pattern": "^rv_[a-z2-7]{26}$"},
    "grant_key": {"type": "string", "pattern": "^g_[a-z2-7]{26}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "source_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-.]{0,127}$"},
    "tenant_auth_epoch_before": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "tenant_auth_epoch_after": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
    "record_revision_after": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "tombstone_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cleanup_outbox_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revoked_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\A[\\x20-\\x7e]+\\Z"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\A[\\x20-\\x7e]+\\Z"}
  },
  "customKeywords": {
    "deepForbiddenProperties": [
      "agent_id", "agent_id_hash", "credential_ref", "credentials", "app_key", "app_secret",
      "body", "body_text", "content", "reply", "replies", "node", "nodes",
      "attachment", "attachments", "attachment_url", "temporary_url",
      "preview_url", "short_url", "presign_url", "download_url",
      "path", "absolute_path", "mirror_root",
      "cookie", "session_token", "authorization"
    ]
  }
}
