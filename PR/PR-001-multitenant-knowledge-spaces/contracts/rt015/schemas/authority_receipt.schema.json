{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt015.authority_receipt.v1",
  "title": "AccessLedger authority-source receipt v1 (RT-015, test-only fake adapter)",
  "description": "Envelope produced by an authoritative permission source (real work-collab permission API or delegated admin bootstrap). RT-015 ships ONLY a fail-closed default adapter; real integration is out-of-scope for this RT. Tests may register a fake in-memory signer (HMAC over signed_payload_bytes) to exercise promote_to_active / refresh_lease paths — signature verification is constant-time.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "signer_id",
    "receipt_type",
    "tenant_id",
    "source_namespace",
    "report_id",
    "grant_key",
    "roles",
    "visibility_scope",
    "permission_source",
    "issued_at",
    "lease_expires_at",
    "signature"
  ],
  "properties": {
    "schema": {"const": "cwk.rt015.authority_receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^ar_[a-z2-7]{26}$"},
    "signer_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9._-]+$"},
    "receipt_type": {"type": "string", "enum": ["grant_promote", "lease_refresh", "revoke_confirm"]},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "source_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-.]{0,127}$"},
    "grant_key": {"type": "string", "pattern": "^g_[a-z2-7]{26}$"},
    "roles": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true, "maxItems": 16},
    "visibility_scope": {"type": "string", "enum": ["full", "partial", "unknown"]},
    "permission_source": {
      "type": "string",
      "enum": ["authoritative_permission_api", "delegated_admin_bootstrap"]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "customKeywords": {
    "deepForbiddenProperties": [
      "agent_id", "agent_id_hash", "credential_ref", "credentials", "app_key", "app_secret",
      "body", "body_text", "content", "reply", "replies", "node", "nodes",
      "attachment", "attachments", "attachment_url", "temporary_url",
      "preview_url", "short_url", "presign_url", "download_url",
      "path", "absolute_path", "mirror_root",
      "cookie", "session_token", "authorization"
    ]
  }
}
