{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.rt015.tenant_view_record.v1",
  "title": "TenantViewStore on-disk overlay record v1 (RT-015)",
  "description": "Wrapper around the frozen cwk.tenant_view.v1 payload used by the internal tenant-view store. The overlay never contains canonical body text; reply_overlay / node_overlay only carry opaque IDs plus optional content_sha256 (the payload itself lives on the source system and, if verified per DESIGN §11, would still be governed by verified_shared_extensions_vN — never RT-015). RT-011 validate_tenant_view is still applied to the nested .view object; this schema only validates the RT-015-local envelope.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "view_key",
    "tenant_id",
    "source_namespace",
    "report_id",
    "canonical_sha256",
    "view",
    "record_revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {"const": "cwk.rt015.tenant_view_record.v1"},
    "view_key": {"type": "string", "pattern": "^g_[a-z2-7]{26}$"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "source_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-.]{0,127}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "view": {"type": "object"},
    "record_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "customKeywords": {
    "deepForbiddenProperties": [
      "agent_id", "agent_id_hash", "credential_ref", "credentials", "app_key", "app_secret",
      "body", "body_text", "canonical_body", "reply_body", "node_body",
      "path", "absolute_path", "mirror_root",
      "cookie", "session_token", "authorization", "prompt_template"
    ]
  }
}
