{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.route_decision.v1",
  "title": "RouteDecision v1",
  "description": "Router decision for one report version under one active Profile. `space_ids[]` elements MUST be opaque space_ids; slugs are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "report_key",
    "canonical_sha256",
    "disposition",
    "space_ids",
    "confidence",
    "reason_codes",
    "profile_version",
    "profile_sha256",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "schema": {"const": "cwk.route_decision.v1"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "report_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[^\\s]{1,256}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"type": "string", "enum": ["index", "archive_no_index", "review"]},
    "space_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sp_[a-z0-9]{10,32}$",
        "description": "Opaque space_id. Slugs (e.g. 'tbs', 'sfe', 'general') are NOT permitted here."
      },
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "profile_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
