{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.query_request.v1",
  "title": "QueryRequest v1",
  "description": "Sandbox-side Broker query. Contains no identity, no path, no credential, no tenant. `space_selector[]` elements MUST be opaque space_ids; slugs are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "query"],
  "properties": {
    "schema": {"const": "cwk.query_request.v1"},
    "query": {"type": "string", "minLength": 1, "maxLength": 4000},
    "space_selector": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sp_[a-z0-9]{10,32}$"},
      "uniqueItems": true,
      "default": []
    },
    "include_dispositions": {
      "type": "array",
      "items": {"type": "string", "enum": ["index", "archive_no_index", "review"]},
      "uniqueItems": true,
      "default": ["index"]
    },
    "time_filter": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": ["string", "null"], "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
  },
  "forbiddenProperties": [
    "tenant_id",
    "agent_id",
    "agent_id_hash",
    "binding_epoch",
    "auth_epoch",
    "credential_ref",
    "credentials",
    "app_key",
    "mirror_root",
    "root",
    "path",
    "absolute_path",
    "profile_version",
    "profile_sha256"
  ]
}
