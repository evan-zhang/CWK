{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.verified_shared_extensions.v1",
  "title": "verified_shared_extensions_vN manifest",
  "description": "Version-controlled, append-only manifest listing tenant-view fields that have been verified as safely shareable and are therefore permitted to appear in canonical evidence. Temporary URLs (attachment presign/preview/short-link) are NEVER permitted here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "manifest_sha256",
    "compared_sample_size",
    "min_field_match_rate",
    "approved_by",
    "approved_at",
    "entries"
  ],
  "properties": {
    "schema": {"const": "cwk.verified_shared_extensions.v1"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compared_sample_size": {"type": "integer", "minimum": 50},
    "min_field_match_rate": {"type": "number", "minimum": 0.9, "maximum": 1.0},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "decision_ref": {"type": ["string", "null"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_path", "match_rate", "sample_ids"],
        "properties": {
          "field_path": {
            "type": "string",
            "description": "Dotted path from CanonicalEnvelope root. Must not equal or contain a URL field or a tenant-identity field."
          },
          "match_rate": {"type": "number", "minimum": 0.9, "maximum": 1.0},
          "sample_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  },
  "forbiddenFieldPaths": [
    "attachment_url",
    "attachments[*].temporary_url",
    "attachments[*].presign_url",
    "attachments[*].preview_url",
    "attachments[*].download_url",
    "short_url",
    "temporary_url",
    "preview_url",
    "presign_url",
    "download_url",
    "reply_overlay[*].temporary_url",
    "tenant_id",
    "agent_id",
    "agent_id_hash",
    "credential_ref"
  ]
}
