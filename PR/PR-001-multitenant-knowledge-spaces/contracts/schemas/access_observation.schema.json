{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.access_observation.v1",
  "title": "AccessObservation v1",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "source_namespace",
    "report_id",
    "observed_at",
    "observation_source",
    "initial_status"
  ],
  "properties": {
    "schema": {"const": "cwk.access_observation.v1"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "source_namespace": {"$ref": "report_key.schema.json#/properties/source_namespace"},
    "report_id": {"$ref": "report_key.schema.json#/properties/report_id"},
    "observed_at": {"type": "string", "format": "date-time"},
    "observation_source": {
      "type": "string",
      "enum": ["tenant_appkey_observation", "legacy_raw_decomposition", "delegated_admin_bootstrap"]
    },
    "roles": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "visibility_scope": {"type": "string", "enum": ["full", "partial", "unknown"]},
    "initial_status": {"type": "string", "enum": ["discovered", "granted"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "maxLength": 512}, "uniqueItems": true}
  }
}
