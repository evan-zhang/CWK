{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.canonical_report.v1",
  "title": "CanonicalEnvelope v1",
  "description": "Shared, immutable canonical evidence for one version of a report. Strict additionalProperties:false at every level; deepForbiddenProperties enforced by the RT-011 validator engine (never any tenant/lane/read/todo/reply/node/attachment/URL/identity fields, even nested).",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "source_namespace",
    "report_id",
    "title",
    "author",
    "created_at",
    "source_updated_at",
    "body",
    "canonical_sha256",
    "normalizer_version"
  ],
  "properties": {
    "schema": {"const": "cwk.canonical_report.v1"},
    "source_namespace": {"$ref": "report_key.schema.json#/properties/source_namespace"},
    "report_id": {"$ref": "report_key.schema.json#/properties/report_id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 4096},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["source_user_id"],
      "properties": {
        "source_user_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_\\-.]+$"},
        "display_name": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "source_updated_at": {"type": "string", "format": "date-time"},
    "body": {"type": "string", "maxLength": 1048576},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalizer_version": {"type": "string", "pattern": "^v[0-9]{1,4}$"},
    "verified_shared_extensions_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]{1,4}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "customKeywords": {
    "deepForbiddenProperties": [
      "tenant_id", "agent_id", "agent_id_hash", "credential_ref", "credentials", "app_key",
      "lane", "read_status", "todo_status", "allowed_actions", "role", "roles",
      "reply", "replies", "reply_overlay", "node", "nodes", "node_overlay",
      "attachment", "attachments", "attachment_permissions",
      "attachment_url", "preview_url", "short_url", "presign_url", "download_url", "temporary_url",
      "collected_at", "observed_at", "path", "absolute_path", "mirror_root",
      "auth_epoch", "binding_epoch", "cookie", "session_token", "authorization"
    ],
    "recomputeCanonicalSha256": true
  }
}
