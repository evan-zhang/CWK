{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwk.pr001.tenant_view.v1",
  "title": "TenantViewEnvelope v1",
  "description": "Per-tenant overlay for one canonical report version. Holds lane/read/todo, roles, allowed_actions, reply/node/attachment overlays and temporary URLs. Never merged into canonical evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "report_key",
    "canonical_sha256",
    "observed_at"
  ],
  "properties": {
    "schema": {"const": "cwk.tenant_view.v1"},
    "tenant_id": {"type": "string", "pattern": "^t_[a-z0-9]{26}$"},
    "report_key": {
      "type": "string",
      "description": "String encoding of ReportKey: '<source_namespace>:<report_id>'.",
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]{1,256}$"
    },
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lane": {"type": ["string", "null"]},
    "read_status": {"type": ["string", "null"], "enum": [null, "unread", "read"]},
    "todo_status": {"type": ["string", "null"], "enum": [null, "pending", "done", "cancelled"]},
    "new_reply_flag": {"type": ["boolean", "null"]},
    "roles": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "visible_event_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "attachment_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachment_id"],
        "properties": {
          "attachment_id": {"type": "string"},
          "permission": {"type": "string", "enum": ["view", "download", "none"]},
          "temporary_url": {
            "type": ["string", "null"],
            "description": "Ephemeral URL. Time-sensitive; MUST NOT be promoted to canonical evidence."
          },
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "reply_overlay": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reply_id"],
        "properties": {
          "reply_id": {"type": "string"},
          "author": {"type": "object"},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "visible": {"type": ["boolean", "null"]}
        }
      }
    },
    "node_overlay": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id"],
        "properties": {
          "node_id": {"type": "string"},
          "type": {"type": ["string", "null"]},
          "visible": {"type": ["boolean", "null"]},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
