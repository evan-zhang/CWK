# Plain KEY=value lines only. This file is parsed, never sourced: an
# `export KEY=value` line is ignored by both the nightly pipeline and doctor.
#
# Required secret. Fill this file through a trusted local editor or masked
# credential setup; never paste the value into chat or command-line arguments.
CWORK_APP_KEY=

# Optional authoritative current-user/report relationship API. Leave empty
# until the Work Report backend publishes the RT-008 batch endpoint. CWK will
# show "关系待确认" and will not infer a negative relationship locally.
CWK_RELATION_API_BASE_URL=https://sg-al-cwork-web.mediportal.com.cn
CWK_RELATION_API_PATH=
CWK_RELATION_API_TIMEOUT_SECONDS=30

# Optional. Leave empty for the default personal knowledge base and
# auto-created/found folder named "工作协同镜像".
CWK_DOCDB_PROJECT_ID=
CWK_DOCDB_ROOT_FILE_ID=

# Optional OpenClaw layout hints. These are paths, not credentials.
# Set CWK_WORKSPACE_DIR when the CWK clone is not directly under the Agent
# Workspace, so doctor can find that Workspace's formal Skill or AGENTS router.
CWK_WORKSPACE_DIR=
CWK_SKILL_ROOTS=

# Optional company Skill locations. Leave empty when OpenClaw uses its normal
# per-user or materialized locations. Set these only when your Agent installs
# company Skills elsewhere.
CMS_CWORK_WORKFLOW_DIR=
CMS_DOCDB_SKILL_DIR=
CMS_AUTH_SKILL_DIR=
CMS_AUTH_LOGIN=

# Optional runtime tuning.
CWK_HISTORY_RUN_NAME=
CWK_DETAIL_CAP=60
CWK_SYNC_DOCDB=false

# Production runtime profile. Cloud-First and cloud/shadow query are paused;
# DocDB may still receive derived Wiki pages and daily HTML previews.
CWK_CLOUD_FIRST=false
CWK_PUBLISH_CLOUD_QUERY_CATALOG=false

# Optional AI pilot. Keep disabled for the stable rules-only nightly.
CWK_AI_ENABLED=false
CWK_AI_DRY_RUN=false
CWK_AI_RECORD_MODEL=
CWK_AI_CLUSTER_MODEL=
CWK_AI_QUALITY_MODEL=
CWK_AI_MAX_PARALLEL=4
CWK_AI_TIMEOUT_SECONDS=120
CWK_AI_AGENT_ID=cwk-ai-reviewer
CWK_AI_THINKING=high

# Optional only when resolving auth through cms-auth-skills.
CWK_SENDER_ID=
CWK_ACCOUNT_ID=default
